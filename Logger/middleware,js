const logger = require('./logger');
const { v4: uuidv4 } = require('uuid');

// Middleware to log all requests
const requestLogger = (req, res, next) => {
  const startTime = Date.now();
  
  // Generate API hash
  const apiHash = uuidv4();
  
  // Store in request for later use
  req.logContext = {
    apiHash,
    startTime,
    customerNo: req.headers['x-customer-no'] || 'LWD00198125',
    deviceType: req.headers['user-agent']?.includes('Android') ? 'android RN' : 
                req.headers['user-agent']?.includes('iPhone') ? 'ios RN' : 'web',
    clientIP: req.ip || req.connection.remoteAddress
  };

  // Log the request
  logger.info('API Request', {
    action: 'request received',
    apiHash: req.logContext.apiHash,
    apiName: req.path,
    apiType: 'request',
    clientIP: req.logContext.clientIP,
    customerNo: req.logContext.customerNo,
    deviceType: req.logContext.deviceType,
    functionName: 'requestLogger',
    loggerName: 'requestLogger',
    logLevel: 20,
    name: 'requestLogger'
  });

  // Override res.json to capture response
  const originalJson = res.json.bind(res);
  res.json = function(data) {
    const duration = Date.now() - startTime;
    
    logger.info('API Response', {
      action: 'response sent',
      apiHash: req.logContext.apiHash,
      apiName: req.path,
      apiType: 'response',
      clientIP: req.logContext.clientIP,
      customerNo: req.logContext.customerNo,
      deviceType: req.logContext.deviceType,
      functionName: 'requestLogger',
      loggerName: 'requestLogger',
      logLevel: 20,
      name: 'requestLogger',
      metaData: {
        duration: `${duration}ms`,
        statusCode: res.statusCode
      }
    });
    
    return originalJson(data);
  };

  next();
};

// Error logging middleware
const errorLogger = (err, req, res, next) => {
  const errorCode = err.code || 'BR.INVALID.DATA.400';
  const messageCode = err.messageCode || 'M0002';
  
  logger.error('API Error', {
    action: 'error response from customCatchError sent to client',
    apiHash: req.logContext?.apiHash || uuidv4(),
    apiName: req.path,
    apiType: 'error response from customCatchError sent to client',
    clientIP: req.logContext?.clientIP || req.ip,
    customerNo: req.logContext?.customerNo || 'UNKNOWN',
    deviceType: req.logContext?.deviceType || 'unknown',
    errorCode: errorCode,
    errorType: 'business',
    functionName: 'customCatchError',
    loggerName: 'customCatchError',
    logLevel: 50,
    messageCode: messageCode,
    metaData: {
      messageCode: messageCode,
      errorCode: errorCode
    },
    name: 'customCatchError'
  });

  res.status(err.status || 400).json({
    success: false,
    errorCode: errorCode,
    messageCode: messageCode,
    message: err.message || 'An error occurred'
  });
};

module.exports = { requestLogger, errorLogger };